<?xml version="1.0" encoding="utf-8"?>
<!-- Offline build: every library is already in the "packages" folder, so no package source is used. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
