<?xml version="1.0" encoding="utf-8"?>
<!-- Keep every downloaded package inside this folder (Windows/.packages), not in ~/.nuget. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
